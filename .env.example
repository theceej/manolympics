# Copy to .env and adjust. Values shown are local-dev defaults.

# ── Database (libSQL / Turso) ──────────────────────────────────────────────────
# Local & Docker: a plain SQLite file.
DATABASE_URL=file:./data/manolympics.db
# Hosted on Turso instead (for Vercel etc.): use the libsql URL + auth token, e.g.
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=eyJhbGciOi...
# DATABASE_AUTH_TOKEN=

# ── WebAuthn / passkeys ────────────────────────────────────────────────────────
#   RP_ID  = registrable domain, no scheme/port (e.g. manolympics.vercel.app)
#   ORIGIN = full origin incl. scheme (e.g. https://manolympics.vercel.app)
RP_ID=localhost
RP_NAME=Manolympics
ORIGIN=http://localhost:5173

# First person allowed to register (becomes admin). Others need an invite code.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# ── Deploy target (optional) ───────────────────────────────────────────────────
# Chooses the SvelteKit adapter. Auto-detected on Vercel; defaults to `node` (Docker).
#   ADAPTER=vercel | node
# ADAPTER=node
